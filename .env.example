# Production mode is the default. Set DJANGO_DEBUG=true only for contributor mode.
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional. Without it, a random key is created once in .secret_key next to the database.
# DJANGO_SECRET_KEY=
# Hosting behind HTTPS: enable redirects, HSTS and secure cookies, and trust your origin.
# DJANGO_HTTPS=true
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# TRUST_PROXY_HTTPS=true
# Change source follows DJANGO_DEBUG unless set; keep it false on a hosted site.
# BHARAT_ALLOW_SOURCE_CHANGE=false
# SQLITE_PATH=/data/bharat.sqlite3
# Free key from https://www.data.gov.in; used only by fetch_postal_data.
# DATA_GOV_IN_API_KEY=
